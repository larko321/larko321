<!doctype html>
<html lang="en"> 
 <head> 
  <meta charset="UTF-8"> 
  <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
  <title>ROT13 Encoder/Decoder</title> 
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      padding: 2rem;
      text-align: center;
    }
    h1 {
      color: #333;
    }
    textarea {
      width: 80%;
      height: 100px;
      padding: 1rem;
      font-size: 1rem;
      margin-bottom: 1rem;
      border-radius: 8px;
      border: 1px solid #ccc;
      resize: none;
    }
    button {
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
      background: #4f46e5;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    button:hover {
      background: #4338ca;
    }
    .output {
      margin-top: 1rem;
      font-weight: bold;
      white-space: pre-wrap;
    }
  </style> 
 </head> 
 <body> 
  <h1>🔐 ROT13 Encoder / Decoder</h1> <textarea id="inputText" placeholder="Enter your message here..."></textarea>
  <br> <button onclick="applyROT13()">Transform</button> 
  <div class="output" id="outputText"></div> 
  <script>
    function applyROT13() {
      const input = document.getElementById("inputText").value;
      const transformed = input.replace(/[a-zA-Z]/g, function(c) {
        const base = c <= 'Z' ? 65 : 97;
        return String.fromCharCode((c.charCodeAt(0) - base + 13) % 26 + base);
      });
      document.getElementById("outputText").textContent = transformed;
    }
  </script> 
 </body>
</html>
